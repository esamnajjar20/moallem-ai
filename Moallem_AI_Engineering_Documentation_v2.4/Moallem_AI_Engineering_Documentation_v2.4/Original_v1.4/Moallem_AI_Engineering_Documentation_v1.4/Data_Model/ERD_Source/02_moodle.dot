digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.22", nodesep="0.34", ranksep="0.62", splines=ortho, fontname="Arial"];
node [shape=record, style="rounded,filled", fillcolor="#F4F7FA", color="#52708D", penwidth=1.1, fontname="Arial", fontsize=10, margin="0.10,0.07"];
edge [color="#65788A", penwidth=1.0, arrowsize=0.7, fontname="Arial", fontsize=8];
org [label="organizations"];
site [label="moodle_sites\n(tenant-scoped site)"];
con [label="moodle_connections\n(credential reference)"];
cap [label="capability_snapshots"];
mem [label="memberships\nconnected by"];
org -> site [label="1 : N"];
site -> con [label="1 : N"];
org -> con [label="1 : N"];
mem -> con [label="1 : N"];
con -> cap [label="1 : N"];
}