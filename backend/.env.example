# Copy to .env for local development. Never commit real secrets. Synthetic data only.
MOALLEM_ENV=development
MOALLEM_LOG_LEVEL=INFO
# Required when MOALLEM_ENV is staging or production (no defaults by design):
# MOALLEM_DATABASE_URL=postgresql://user:password@host:5432/dbname
# MOALLEM_REDIS_URL=redis://host:6379/0
MOALLEM_READINESS_TIMEOUT_SECONDS=2.0
# Auth0 Resource Server. Login/refresh/logout are handled by the native client SDK, not this API.
# Set all three or none; staging/production startup fails without them. Access-token max is 900s.
# MOALLEM_AUTH_ISSUER=https://YOUR-TENANT.auth0.com/
# MOALLEM_AUTH_AUDIENCE=your-api-identifier
# MOALLEM_AUTH_MAX_TOKEN_LIFETIME_SECONDS=900
# Development-only AES-256-GCM key: base64 encoding of exactly 32 random bytes.
# Production secret storage stays disabled until a KMS/Secret Manager is configured.
# MOALLEM_SECRET_ENCRYPTION_KEY=
# Required to enable task creation/event cursors; use separate random values of at least 32 bytes.
# MOALLEM_IDEMPOTENCY_HMAC_KEY=
# MOALLEM_IDEMPOTENCY_RETENTION_SECONDS=
# MOALLEM_EVENT_CURSOR_HMAC_KEY=
# P7: approval records expire within this configured window (60..86400 seconds).
# This config alone does not authorize publishing; DEC-027/041/043 and Moodle staging gates remain.
# MOALLEM_APPROVAL_TTL_SECONDS=3600
# Permission policy for the API: deny_all (default, fail-closed) or teacher_mvp (DEC-027).
# MOALLEM_PERMISSION_POLICY=deny_all
# Required for the worker in staging/production; provide explicit operational tuning.
# MOALLEM_TASK_QUEUE_POLL_SECONDS=
# MOALLEM_TASK_QUEUE_BATCH_SIZE=
# MOALLEM_TASK_QUEUE_LEASE_SECONDS=
# MOALLEM_TASK_QUEUE_LEASE_RENEW_SECONDS=
# MOALLEM_TASK_QUEUE_MAX_ATTEMPTS=
# MOALLEM_TASK_QUEUE_RETRY_BASE_SECONDS=
# MOALLEM_TASK_QUEUE_RETRY_MAX_SECONDS=
# MOALLEM_TASK_QUEUE_SHUTDOWN_GRACE_SECONDS=
# MOALLEM_TASK_QUEUE_IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=
# MOALLEM_TASK_QUEUE_IDEMPOTENCY_CLEANUP_BATCH_SIZE=
# Optional AI provider transport. Leave every value unset until ADR-018 is approved.
# Configuring these values creates a provider adapter only; DenyAllAIExecution still blocks calls.
# MOALLEM_AI_PROVIDER_ID=approved-provider-id
# MOALLEM_AI_MODEL_ID=approved-exact-model-id
# MOALLEM_AI_MODEL_VERSION=approved-immutable-revision
# MOALLEM_AI_REGION=approved-processing-region
# MOALLEM_AI_BASE_URL=https://approved-provider.example/v1
# MOALLEM_AI_API_KEY=<injected-secret>
# MOALLEM_AI_ALLOWED_HOSTS=["approved-provider.example"]
# MOALLEM_AI_TIMEOUT_SECONDS=60
# MOALLEM_AI_MAX_REQUEST_BYTES=2097152
# MOALLEM_AI_MAX_RESPONSE_BYTES=2097152
